from pathlib import Path

# Get the directory where this Snakefile is located
BASE = Path(workflow.basedir)
configfile: str(BASE / "config" / "config.yaml")

# Allow command-line overrides for paths
OUTPUT_FOLDER = config["output_folder"]
DATA_FOLDER = config["data_folder"]
SCRIPTS_DIR = config.get("scripts_dir", ".")
ADJUST_SCRIPT = config.get("adjust_script", "../adjust/adjust.R")
BOOTSTRAP_TOTAL = config["bootstrap_total"]
BOOTSTRAP_PER_JOB = config["bootstrap_per_job"]
N_HVG = config["n_hvg"]
CHUNKS = range(BOOTSTRAP_TOTAL // BOOTSTRAP_PER_JOB)
K_FOLDS = config["k_folds"]
K_VALUES = config["k_values"]

rule all: 
    input: 
        OUTPUT_FOLDER + "classify_all_figures/my_scaling_MCC.png", 
        OUTPUT_FOLDER + "classify_all_figures/my_scaling_ROC_AUC.png",
        # OUTPUT_FOLDER + "classify_all_figures/scaling_MCC.png",
        # OUTPUT_FOLDER + "classify_all_figures/scaling_ROC_AUC.png"

rule plot_performance:
    input:
        aggregated_metrics_file=DATA_FOLDER + "classify_metrics/all_metrics.csv.gz",
        metadata_file=DATA_FOLDER + "geo_metadata.csv",
        cv_file=DATA_FOLDER + "cv_metrics.csv.gz",
        script=SCRIPTS_DIR + "plot_performance.R"
    output: 
        OUTPUT_FOLDER + "classify_all_figures/my_scaling_MCC.png", 
        OUTPUT_FOLDER + "classify_all_figures/my_scaling_ROC_AUC.png",
        # OUTPUT_FOLDER + "classify_all_figures/scaling_MCC.png",
        # OUTPUT_FOLDER + "classify_all_figures/scaling_ROC_AUC.png"
    resources: 
        mem_mb=4000,
        runtime=20
    threads: 1
    log: 
        "log/plot_performance.log"
    params:
        fig_dir = OUTPUT_FOLDER + "classify_all_figures",
        order_dir = DATA_FOLDER + "all_combined/gse_order_files"
    shell:
        """
        set -euo pipefail
        Rscript {input.script} \
            --metrics_file {input.aggregated_metrics_file} \
            --figures_dir {params.fig_dir} \
            --metadata_file {input.metadata_file} \
            --cv_file {input.cv_file} \
            --order_folder {params.order_dir} \
            &> {log}
        """

rule aggregate_metrics:
    input: 
        metrics_data=expand(
            DATA_FOLDER + "classify_metrics/{adjuster}/{adjuster}-{k}_studies-test_{test_source}-metrics.csv.gz",
            adjuster=config["adjuster"],
            k=K_VALUES,
            test_source=config["dataset_ids"]
        ),
        script=SCRIPTS_DIR + "aggregate_metrics.py"
    output:
        output_path=DATA_FOLDER + "classify_metrics/all_metrics.csv.gz"
    resources: 
        mem_mb=4000,
        runtime=20
    threads: 1
    log: 
        "log/aggregate.log"
    params:
        metrics_dir=DATA_FOLDER + "classify_metrics"
    shell:
        """
        set -euo pipefail
        python {input.script} --metrics-dir {params.metrics_dir} --output {output.output_path} &> {log}
        """

rule classify:
    input:
        adjusted_csv = DATA_FOLDER + "adjusted_data/{adjuster}/{adjuster}-{k}_studies-test_{test_source}.csv.gz",
        script = SCRIPTS_DIR + "run_classifier.py"
    output: 
        metrics_file = DATA_FOLDER + "classify_metrics/{adjuster}/{adjuster}-{k}_studies-test_{test_source}-metrics.csv.gz"
    log: 
        "log/classify/{adjuster}_{k}_{test_source}.log"
    resources: 
        mem_mb=16000,
        runtime=lambda wildcards, attempt: 30 if attempt == 1 else 120
    threads: 1
    params:
        output_dir = DATA_FOLDER + "classify_metrics"
    shell:
        r"""
        set -euo pipefail
        python {input.script} \
            --csv {input.adjusted_csv} \
            --outdir {params.output_dir} \
            &> {log}
        """

rule adjust:
    priority: 90
    input:
        combined_file = DATA_FOLDER + "all_combined/all_combined.csv",
        order_file = DATA_FOLDER + "all_combined/gse_order_files/{test_source}_order.csv.gz",
        subset_script = SCRIPTS_DIR + "subset_prep.R"
    output:
        DATA_FOLDER + "adjusted_data/{adjuster}/{adjuster}-{k}_studies-test_{test_source}.csv.gz"
    resources:
        mem_mb=44000,
        runtime = lambda wildcards, attempt: 45 if attempt == 1 else 120
    threads: 1
    log:
        "log/adjust/{adjuster}_{k}_{test_source}_adjust.log"
    params:
        output_dir = DATA_FOLDER + "adjusted_data",
        adjust_script = ADJUST_SCRIPT,
        metadata = DATA_FOLDER + "geo_metadata.csv"
    shell:
        """
        set -euo pipefail
        tmpfile=$(mktemp /tmp/subset_XXXXXX.csv.gz)
        trap "rm -f $tmpfile" EXIT

        Rscript {input.subset_script} \
            --input {input.combined_file} \
            --test {wildcards.test_source} \
            --order {input.order_file} \
            --k {wildcards.k} \
            --output $tmpfile \
            &>> {log}

        Rscript {SCRIPTS_DIR}run_scaling_experiment.R \
            --adjuster {wildcards.adjuster} \
            --subset-path $tmpfile \
            --k {wildcards.k} \
            --test {wildcards.test_source} \
            --output-dir {params.output_dir} \
            --adjust-script {params.adjust_script} \
            --metadata-file {params.metadata} \
            &>> {log}
        """

rule cross_validate:
    input: 
        combined_file = DATA_FOLDER + "all_combined/all_combined.csv",
        script = SCRIPTS_DIR + "run_cv_per_test.py"
    output:
        cv_file = DATA_FOLDER + "cv_metrics.csv.gz"
    resources:
        mem_mb=16000,
        runtime=360
    threads: 1
    log:
        "log/cross_validation/cv.log"
    params:
        k_folds=K_FOLDS
    shell:
        """
        set -euo pipefail
        python {input.script} \
            --combined_csv {input.combined_file} \
            --outdir {DATA_FOLDER} \
            --k_folds {params.k_folds} \
            &> {log}
        """

rule make_order_files:
    input: 
        combined_file = DATA_FOLDER + "all_combined/all_combined.csv",
        script = SCRIPTS_DIR + "make_order_files.py"
    output: 
        order_file = DATA_FOLDER + "all_combined/gse_order_files/{test_source}_order.csv.gz"
    resources: 
        mem_mb=8000,
        runtime=10
    threads: 1
    log: 
        "log/order/{test_source}_order.log"
    params:
        output_dir = DATA_FOLDER + "all_combined/gse_order_files"
    shell:
        """
        set -euo pipefail
        python {input.script} \
            --input {input.combined_file} \
            --output {output.order_file} \
            &> {log}
        """

rule summarize_gold:
    input:
        gold_dir=DATA_FOLDER + "gold",
        script=SCRIPTS_DIR + "summarize_gold_data.py"
    output:
        DATA_FOLDER + "gold/csv_value_summaries.csv"
    resources:
        mem_mb=8000,
        runtime=30
    threads: 1
    log:
        "log/summarize_gold.log"
    shell:
        """
        set -euo pipefail
        python {input.script} &> {log}
        """
